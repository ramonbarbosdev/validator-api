# Copie para .env (nao commitar)

# Repo da API Java validada (checkout de PR)
GITHUB_REPOSITORY=org/sua-api
REPO_ROOT=/data/app
# Dev local Windows: REPO_ROOT=C:\path\sua-api

# Opcional — padrao: pack/ dentro deste repo (ou /app/pack na imagem Docker)
# CURSOR_API_VALIDATOR_ROOT=

GITHUB_WEBHOOK_SECRET=
WEBHOOK_PORT=8765
WEBHOOK_HOST=0.0.0.0

RUNNER_API_TOKEN=
# VALIDATOR_API_CORS_ORIGIN=http://127.0.0.1:5173

CURSOR_API_KEY=
GITHUB_TOKEN=

# Stack: java-spring-esimples (overlay e-Simples) ou omita para install sem stack extra
# API_VALIDATOR_STACK=java-spring-esimples
# API_VALIDATOR_REQUIRE_LABEL=validar-api
# API_VALIDATOR_BLOCK_LABEL=Alteração Necessária
GITHUB_BASE_REF=develop
