# Copie para .env na raiz do validator-api (nao commitar)

GITHUB_REPOSITORY=gpi-organizacao/esimples-api
REPO_ROOT=C:\path\esimples-api
CURSOR_API_VALIDATOR_ROOT=C:\path\cursor-api-validator-java

GITHUB_WEBHOOK_SECRET=
WEBHOOK_PORT=8765
WEBHOOK_HOST=0.0.0.0

# Token para GET /status e POST /api/v1/validate (validator-front / VPS)
RUNNER_API_TOKEN=

# Browser (validator-front React): ex. http://127.0.0.1:5173
# VALIDATOR_API_CORS_ORIGIN=http://127.0.0.1:5173

CURSOR_API_KEY=
GITHUB_TOKEN=

# API_VALIDATOR_REQUIRE_LABEL=validar-api
# API_VALIDATOR_BLOCK_LABEL=Alteração Necessária
# API_VALIDATOR_NEW_COMMENT_EACH_RUN=1
# API_VALIDATOR_STACK=java-spring-esimples
GITHUB_BASE_REF=develop
