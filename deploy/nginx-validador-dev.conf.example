# Copie para sites-available (Debian/Ubuntu) e ajuste dominio + IP Tailscale do PC.
# sudo ln -s /etc/nginx/sites-available/validador-dev /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
# TLS: sudo certbot --nginx -d validador-dev.seudominio.com

upstream validator_dev_pc {
    server 100.79.228.111:8765;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name validador-dev.seudominio.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name validador-dev.seudominio.com;

    # certbot costuma preencher ssl_certificate* aqui
    # ssl_certificate     /etc/letsencrypt/live/validador-dev.seudominio.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/validador-dev.seudominio.com/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://validator_dev_pc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
    }
}
